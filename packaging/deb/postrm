#!/bin/sh
set -e

case "$1" in
purge)
	# Comme « kura-agent uninstall --purge » : configuration, état, journaux et
	# secrets de Kura. Le compte kura-agent est gardé (pratique Debian).
	rm -rf /etc/kura /var/lib/kura /var/log/kura /var/cache/kura-install
	rm -f /etc/credstore.encrypted/kura.*
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
	fi
	;;
esac

exit 0
